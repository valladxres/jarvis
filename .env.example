# ──────────────────────────────────────────────────────────────────────────────
#  Jarvis — Configuración
#  Copia este archivo como .env y personaliza los valores.
#  El archivo .env NUNCA debe subirse a GitHub (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# Tu nombre para el saludo (opcional)
# Si lo dejas vacío, dirá "Bienvenido a casa."
JARVIS_NOMBRE=

# URL de Spotify que se abrirá al activarse
# Copia el enlace de la canción desde Spotify → Compartir → Copiar enlace de canción
# Formato: spotify:track:ID  o  https://open.spotify.com/track/ID
JARVIS_SPOTIFY_URL=spotify:track:2zYzyRzz6pRmhPzyfMEC8s

# Aplicaciones a abrir separadas por coma
# macOS: Terminal,Claude   |   Windows: cmd,Claude
JARVIS_APPS=Terminal,Claude

# ──────────────────────────────────────────────────────────────────────────────
#  Sensibilidad del micrófono
# ──────────────────────────────────────────────────────────────────────────────
# Valor entre 0.0 y 1.0.
# Más bajo = más sensible (detecta aplausos suaves, puede haber falsos positivos).
# Más alto = menos sensible (requiere aplausos fuertes).
# Recomendado: 0.15 (entorno silencioso) — 0.30 (entorno ruidoso)
JARVIS_THRESHOLD=0.20

# ──────────────────────────────────────────────────────────────────────────────
#  Voz (Text-to-Speech)
# ──────────────────────────────────────────────────────────────────────────────

# [macOS] Nombre de la voz del sistema.
# Ver voces disponibles: say -v '?'
# Voces en español: Monica, Paulina, Juan
JARVIS_VOICE_MAC=Monica

# [Windows] Código de idioma para pyttsx3 (ej: es, en, fr)
JARVIS_VOICE_LANG=es

# Velocidad de habla en palabras por minuto (normal ≈ 150)
JARVIS_VOICE_RATE=148
